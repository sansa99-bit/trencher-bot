{
  "name": "trencher-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Solana memecoin scanner + Telegram calling bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:mock": "cross-env SCANNER_MODE=mock tsx src/index.ts",
    "dev:live": "cross-env SCANNER_MODE=live tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "node-fetch": "^3.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": { "node": ">=20.6" }
}
