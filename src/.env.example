# ---- TELEGRAM ----
# Jeton fourni par @BotFather (/newbot). Ne jamais committer la vraie valeur.
TELEGRAM_BOT_TOKEN=
# Chats autorisés à utiliser les commandes. Séparés par des virgules.
TELEGRAM_ALLOWED_CHAT_IDS=
# Chats recevant les alertes automatiques. Vide => identique à ALLOWED.
TELEGRAM_ALERT_CHAT_IDS=
# Mettre à false pour désactiver Telegram (alertes rendues en console).
TELEGRAM_ENABLED=true

# ---- HELIUS ----
HELIUS_API_KEY=

# ---- SCANNER ----
# mock = données simulées, aucun appel réseau | live = Helius WebSocket
SCANNER_MODE=mock
LOG_LEVEL=info

# ---- ALERTES ----
ALERT_MIN_SCORE=75
ALERT_COOLDOWN_MS=180000
ALERT_SCORE_DELTA=5
ALERT_IGNORE_DURATION_MS=3600000

# ---- ECONOMICS ----
SOL_PRICE_FALLBACK=150
SOL_PRICE_REFRESH_MS=60000
